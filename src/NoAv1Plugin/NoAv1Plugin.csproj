<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>NoAv1Plugin</AssemblyName>
    <!-- plugin.json's "version" (a clean SemVer 2.0 MAJOR.MINOR.PATCH string) is the single
         source of truth for the plugin's version — read it here instead of duplicating it, so
         this assembly's compiled version can never drift out of sync with it again. The SDK
         pads a 3-part <Version> into a 4-part AssemblyVersion (e.g. "1.0.0" -> 1.0.0.0), and
         build/package-repo.sh applies that exact same padding when generating the repository
         manifest's version. Jellyfin's web UI reads the compiled AssemblyVersion to build
         Disable/Uninstall/Enable API calls, but the actual server-side plugin lookup compares
         against Version.Parse(plugin.json's "version") — "1.0.0" vs "1.0.0.0" parse to
         *unequal* System.Version values (Revision -1 vs 0), so any mismatch here makes
         Jellyfin's own Disable/Uninstall buttons 404 against a plugin it just listed as
         installed. Don't hand-edit this value; bump plugin.json's "version" instead. -->
    <PluginManifestPath>$(MSBuildThisFileDirectory)plugin.json</PluginManifestPath>
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText($(PluginManifestPath))), '"version"\s*:\s*"([^"]+)"').Groups[1].Value)</Version>
  </PropertyGroup>

  <!-- Built from within the Jellyfin source tree (see build/container-build.sh), so these
       relative paths resolve to the sibling Jellyfin server projects. `dotnet publish` copies
       these (and their transitive deps) into the output regardless of Private/copy-local
       settings, so container-inner.sh prunes the publish output down to just NoAv1Plugin.dll
       afterward — the server loads every DLL it finds in a plugin's folder into that plugin's
       own isolated AssemblyLoadContext, so shipping copies of server assemblies would load a
       second, distinct set of those types alongside the host's and break DI/type identity. -->
  <ItemGroup>
    <ProjectReference Include="../../../MediaBrowser.Common/MediaBrowser.Common.csproj" />
    <ProjectReference Include="../../../MediaBrowser.Controller/MediaBrowser.Controller.csproj" />
    <ProjectReference Include="../../../MediaBrowser.Model/MediaBrowser.Model.csproj" />
    <!-- Only for the PlaybackInfoDto type (Api/NoAv1PlaybackInfoFilter.cs needs to type-match
         the actual action argument MediaInfoController binds from the client's POST body, to
         edit its submitted DeviceProfile before StreamBuilder sees it). -->
    <ProjectReference Include="../../../Jellyfin.Api/Jellyfin.Api.csproj" />
  </ItemGroup>

  <!-- Needed for the admin API controller (Api/NoAv1Controller.cs) and its ASP.NET Core MVC types. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>
</Project>
